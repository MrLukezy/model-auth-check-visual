{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Model Auth Check",
  "identifier": "com.modelauthcheck.app",
  "version": "0.1.0",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1422",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Model Auth Check",
        "width": 1100,
        "height": 720,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:* http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "icon": ["icons/icon.ico"],
    "active": true,
    "targets": ["nsis", "msi", "app", "dmg", "deb", "rpm"]
  }
}
